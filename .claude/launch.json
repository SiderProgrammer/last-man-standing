{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lms-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@lms/server"
      ],
      "port": 8787
    },
    {
      "name": "lms-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@lms/client"
      ],
      "port": 5173
    },
    {
      "name": "lms-fork",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:fork"
      ],
      "port": 5174
    },
    {
      "name": "lms-server-load",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/load-server.mjs"
      ],
      "port": 8789
    },
    {
      "name": "lms-server-load-inline",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--input-type=module",
        "-e",
        "process.env.VERIFY_THREADS='0'; process.env.WS_PORT='8790'; process.env.METRICS_PORT='9466'; await import('./scripts/load-server.mjs');"
      ],
      "port": 8790
    }
  ]
}
