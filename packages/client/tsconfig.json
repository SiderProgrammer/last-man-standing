{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    // A leaf app: nothing imports it, so it emits nothing and is not part of
    // the `tsc --build` project graph. That drops the `composite` requirement
    // and the dist-types output no package.json entry ever pointed at.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    // Resolved to source, exactly as vite.config.ts aliases it, so tsc and the
    // bundler agree on which files are being compiled.
    "paths": {
      "@lms/consensus": ["../consensus/src/index.ts"],
      "@lms/contracts": ["../contracts/src/index.ts"],
      "@lms/api": ["../api/src/index.ts"],
      "@lms/engine": ["../engine/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
