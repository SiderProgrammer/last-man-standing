{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Node for tests that read the source tree, such as the CSP guard.
    "types": ["vite/client", "node"],
    "paths": {
      "@lms/consensus": ["../consensus/src/index.ts"],
      "@lms/contracts": ["../contracts/src/index.ts"],
      "@lms/api": ["../api/src/index.ts"],
      "@lms/engine": ["../engine/src/index.ts"],
      "@lms/engine/bots": ["../engine/src/bots/strategy.ts"],
      "@lms/engine/sim": ["../engine/src/sim/simulate.ts"]
    }
  },
  "include": ["test/**/*.ts"]
}
