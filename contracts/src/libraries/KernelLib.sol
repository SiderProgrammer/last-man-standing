pragma solidity 0.8.28;

import {HashLib} from "./HashLib.sol";

/// @title KernelLib
/// @notice Solidity port of `resolveRound` in `packages/engine/src/kernel/resolve.ts`.
///
/// @dev This is what makes a signed history root enforceable: given one round's
///      starting HP and its published actions, targets and salts, it computes
///      the HP and eliminations that round must have produced. The fraud proof
///      runs it over a whole match and compares with what the attestors signed.
///
///      It must agree with the TypeScript kernel bit for bit. Both are pure
///      integer arithmetic over the same inputs, and `MatchVerifier.t.sol`
///      replays matches generated by the TypeScript engine to hold them to it.
///      A change to either side is a consensus change.
library KernelLib {
    uint8 internal constant NONE = 0;
    uint8 internal constant ATTACK = 1;
    uint8 internal constant DEFEND = 2;
    uint8 internal constant HIDE = 3;

    /// @dev Same nonce space as `PARRY_NONCE_BASE` in the TypeScript kernel.
    uint32 internal constant PARRY_NONCE_BASE = 256;
    uint256 private constant NO_PARRY = type(uint256).max;

    /// @notice One published round: the preimage of its round hash, minus the round number.
    struct Round {
        uint8[] actions;
        uint8[] targets;
        bytes32[] salts;
        uint32[] hpAfter;
        uint8[] eliminated;
    }

    function hashRound(uint32 round, Round memory data) internal pure returns (bytes32) {
        return HashLib.hashRound(round, data.actions, data.targets, data.salts, data.hpAfter, data.eliminated);
    }

    /// @notice True when `data` is a round the engine could have published
    ///         after a round that left the seats on `hpBefore`.
    /// @dev Two checks. The record must be canonical — every field set the way
    ///      the engine writes it, so a quorum cannot hide a fabricated outcome
    ///      behind an encoding the replay would read differently — and the
    ///      outcome must be exactly what the inputs resolve to.
    function isValidRound(
        HashLib.Rules memory rules,
        bytes32 seed,
        uint32 round,
        uint32[] memory hpBefore,
        Round memory data
    ) internal pure returns (bool) {
        if (!isCanonical(hpBefore, data)) return false;
        (uint32[] memory hpAfter, uint8[] memory eliminated) =
            resolve(rules, seed, round, hpBefore, data.actions, data.targets, data.salts);
        return _equal(hpAfter, data.hpAfter) && _equal(eliminated, data.eliminated);
    }

    /// @dev The shape `hashRound` in TypeScript gives every record: one entry
    ///      per seat; dead seats and seats that did not reveal carry `NONE`, a
    ///      zero target and a zero salt; only an attack carries a target.
    function isCanonical(uint32[] memory hpBefore, Round memory data) internal pure returns (bool) {
        uint256 seats = hpBefore.length;
        if (
            data.actions.length != seats || data.targets.length != seats || data.salts.length != seats
                || data.hpAfter.length != seats
        ) return false;
        for (uint256 i = 0; i < seats; ++i) {
            uint8 action = data.actions[i];
            if (action > HIDE) return false;
            if (hpBefore[i] == 0 && (action != NONE || data.salts[i] != bytes32(0))) return false;
            if (action != ATTACK && data.targets[i] != 0) return false;
            if (action == NONE && data.salts[i] != bytes32(0)) return false;
        }
        return true;
    }

    /// @notice Resolves one round. Mirrors `resolveRound` line for line.
    /// @param hpBefore HP of every seat at the start of the round; zero is dead.
    function resolve(
        HashLib.Rules memory rules,
        bytes32 seed,
        uint32 round,
        uint32[] memory hpBefore,
        uint8[] memory actions,
        uint8[] memory targets,
        bytes32[] memory salts
    ) internal pure returns (uint32[] memory hpAfter, uint8[] memory eliminated) {
        int256[] memory hp = _attacks(rules, HashLib.roundSeed(seed, round, salts), hpBefore, actions, targets);
        return _stormAndEliminate(rules, round, hpBefore, actions, hp);
    }

    /// @dev Every attack, in seat order, against the state at the start of the
    ///      round. Returns the damage each seat took, as a negative number.
    function _attacks(
        HashLib.Rules memory rules,
        bytes32 entropy,
        uint32[] memory hpBefore,
        uint8[] memory actions,
        uint8[] memory targets
    ) private pure returns (int256[] memory hp) {
        hp = new int256[](hpBefore.length);
        uint256[] memory parriedBy = _parries(entropy, hpBefore, actions, targets);

        for (uint256 a = 0; a < hpBefore.length; ++a) {
            if (!_isValidAttack(a, hpBefore, actions, targets)) continue;
            uint256 victim = targets[a];
            if (actions[victim] == DEFEND && parriedBy[victim] == a) {
                hp[a] -= int256(uint256(rules.riposteDamage));
                continue;
            }
            // forge-lint: disable-next-line(unsafe-typecast)
            if (actions[victim] == HIDE && HashLib.drawBps(entropy, uint32(a)) < rules.hideEvadeBps) continue;
            hp[victim] -= int256(uint256(rules.attackDamage));
        }
    }

    /// @dev Applies the storm, rescues a lone survivor from a wipe, and orders
    ///      the eliminations. `hp` arrives holding the attack damage only.
    function _stormAndEliminate(
        HashLib.Rules memory rules,
        uint32 round,
        uint32[] memory hpBefore,
        uint8[] memory actions,
        int256[] memory hp
    ) private pure returns (uint32[] memory hpAfter, uint8[] memory eliminated) {
        uint256 seats = hpBefore.length;
        uint256 storm = round > rules.stormGraceRounds
            ? uint256(round - rules.stormGraceRounds) * rules.stormBaseDamage
            : 0;
        uint256 hiddenStorm = (storm * rules.hideStormBps) / HashLib.BPS_DENOMINATOR;

        bool[] memory doomed = new bool[](seats);
        uint256 living;
        uint256 doomedCount;
        for (uint256 i = 0; i < seats; ++i) {
            if (hpBefore[i] == 0) continue;
            ++living;
            hp[i] += int256(uint256(hpBefore[i])) - int256(actions[i] == HIDE ? hiddenStorm : storm);
            if (hp[i] <= 0) {
                doomed[i] = true;
                ++doomedCount;
            }
        }

        // A round may not wipe the lobby: the least overkilled survives on 1 HP,
        // the earlier seat on a tie.
        if (living > 0 && doomedCount == living) {
            uint256 survivor = seats;
            for (uint256 i = 0; i < seats; ++i) {
                if (hpBefore[i] != 0 && (survivor == seats || hp[i] > hp[survivor])) survivor = i;
            }
            hp[survivor] = 1;
            doomed[survivor] = false;
            --doomedCount;
        }

        eliminated = _eliminationOrder(hp, doomed, doomedCount);
        hpAfter = new uint32[](seats);
        for (uint256 i = 0; i < seats; ++i) {
            // forge-lint: disable-next-line(unsafe-typecast)
            if (hpBefore[i] != 0 && !doomed[i]) hpAfter[i] = uint32(uint256(hp[i]));
        }
    }

    /// @dev For each defender, the one attacker it parries: drawn from the
    ///      round seed among the valid attackers on it, in seat order.
    function _parries(bytes32 entropy, uint32[] memory hpBefore, uint8[] memory actions, uint8[] memory targets)
        private
        pure
        returns (uint256[] memory parriedBy)
    {
        uint256 seats = hpBefore.length;
        parriedBy = new uint256[](seats);
        for (uint256 victim = 0; victim < seats; ++victim) {
            parriedBy[victim] = NO_PARRY;
            if (hpBefore[victim] == 0 || actions[victim] != DEFEND) continue;

            uint256 count;
            for (uint256 a = 0; a < seats; ++a) {
                if (_isValidAttack(a, hpBefore, actions, targets) && targets[a] == victim) ++count;
            }
            if (count == 0) continue;

            // forge-lint: disable-next-line(unsafe-typecast)
            uint256 pick = HashLib.draw(entropy, PARRY_NONCE_BASE + uint32(victim)) % count;
            for (uint256 a = 0; a < seats; ++a) {
                if (!_isValidAttack(a, hpBefore, actions, targets) || targets[a] != victim) continue;
                if (pick == 0) {
                    parriedBy[victim] = a;
                    break;
                }
                --pick;
            }
        }
    }

    function _isValidAttack(uint256 attacker, uint32[] memory hpBefore, uint8[] memory actions, uint8[] memory targets)
        private
        pure
        returns (bool)
    {
        if (hpBefore[attacker] == 0 || actions[attacker] != ATTACK) return false;
        uint256 victim = targets[attacker];
        return victim < hpBefore.length && victim != attacker && hpBefore[victim] != 0;
    }

    /// @dev Worst-placed first: lowest HP, then lowest seat. Insertion sort;
    ///      a round eliminates at most a handful of seats.
    function _eliminationOrder(int256[] memory hp, bool[] memory doomed, uint256 count)
        private
        pure
        returns (uint8[] memory order)
    {
        order = new uint8[](count);
        uint256 filled;
        for (uint256 i = 0; i < hp.length; ++i) {
            if (!doomed[i]) continue;
            uint256 j = filled;
            while (j > 0 && hp[order[j - 1]] > hp[i]) {
                order[j] = order[j - 1];
                --j;
            }
            // forge-lint: disable-next-line(unsafe-typecast)
            order[j] = uint8(i);
            ++filled;
        }
    }

    function _equal(uint32[] memory a, uint32[] memory b) private pure returns (bool) {
        if (a.length != b.length) return false;
        for (uint256 i = 0; i < a.length; ++i) {
            if (a[i] != b[i]) return false;
        }
        return true;
    }

    function _equal(uint8[] memory a, uint8[] memory b) private pure returns (bool) {
        if (a.length != b.length) return false;
        for (uint256 i = 0; i < a.length; ++i) {
            if (a[i] != b[i]) return false;
        }
        return true;
    }
}
