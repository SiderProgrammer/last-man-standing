# ---------------------------------------------------------------- game server
# Copy to .env and fill in. Every value has a working default except the keys,
# so `npm run dev --workspace @lms/server` boots in practice-only mode with an
# empty file.

WS_PORT=8787

# Hub chain the escrow is deployed on. 11155111 = Sepolia.
CHAIN_ID=11155111

# Phase timers in milliseconds. Shorten them for local play.
COMMIT_MS=20000
REVEAL_MS=12000

# Pause after each round so clients can replay it before the next commit clock
# starts. The client's worst-case replay is budgeted to fit inside 2500; set 0 to
# open the next window immediately (the animation still plays, controls stay live).
REPLAY_MS=2500

# ------------------------------------------------------------ gateway limits
# Connection caps. Per IP is generous enough for a household behind one NAT.
MAX_CONNECTIONS=10000
MAX_CONNECTIONS_PER_IP=20
# A socket that has not logged in by then is closed and its nonce expires.
LOGIN_TIMEOUT_MS=120000
# Comma-separated Origins the WebSocket handshake accepts. Blank accepts any,
# which suits local development; set it in production.
# ALLOWED_ORIGINS=https://play.example.com
# Read the client IP from X-Forwarded-For. Only behind a proxy that sets it:
# otherwise any client can claim any IP and skip the per-IP limits.
TRUST_PROXY=false
# Worker threads that recover login signatures off the event loop. Unset picks
# cores - 1 (max 4); 0 recovers inline. See docs/LOAD_TESTING.md.
# VERIFY_THREADS=4
# JSON overrides for any gateway limit in packages/server/src/gateway/limits.ts.
# GATEWAY_LIMITS={"messageRate":10,"relayBurstPerWallet":5}

# ------------------------------------------------------------------- on-chain
# Leave RPC_URL or ESCROW_ADDRESS blank to run the server without a chain: the
# practice lobby still works, nothing is escrowed, and nothing is settled.
RPC_URL=
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# Attestor key. Signs the EIP-712 MatchResult and relays `settle`. On a real
# deployment each attestor runs its own server with its own key and the escrow
# requires a quorum; a single key is a testnet convenience, not a design.
ATTESTOR_PK=

# Optional. Pays for the permissionless `lockMatch` call once a lobby is full or
# its join window expires. Defaults to ATTESTOR_PK. Locking is permissionless,
# so if this is unset any player can lock the lobby themselves.
KEEPER_PK=

# --------------------------------------------------------------- avatars
# Cosmetic NFT avatars. The collection is deployed per chain rather than
# bridged, so one entry per chain players mint on — reading a spoke's collection
# needs that spoke's RPC, which is why the URL travels with the address.
# Leave blank and nobody wears an avatar; nothing else changes.
#
# AVATAR_COLLECTIONS=[{"chainId":11155111,"address":"0x…","rpcUrl":"https://…"}]
AVATAR_COLLECTIONS=

# Prefix that `ipfs://` is rewritten to when the server fetches avatar metadata.
# The server does this hop, not the browser, so there is one cache and one
# timeout instead of every client hitting the gateway for the same files.
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ------------------------------------------------------------ session keys
# `SessionKeyDelegate` on the hub chain. Players delegate their EOA to it under
# EIP-7702 and grant this browser a scoped, expiring key, so reconnecting does
# not prompt their wallet. Requires RPC_URL: a session login is verified with an
# ERC-1271 call, and the server will not advertise a delegate it cannot check.
# Blank disables the offer; logins then always cost a wallet signature.
SESSION_DELEGATE=

# ----------------------------------------------------------- token payment
# Lets players join paying in an ERC-20 instead of ETH, swapped through Uniswap
# v4 by ZapJoin. All three or none; blank offers ETH only. Needs an escrow.
# ZAP_JOIN: from the deploy script's output (it deploys one when POOL_MANAGER is set).
# V4_QUOTER: v4-periphery's quoter on the hub chain.
#   Sepolia: 0x61b3f2011a92d183c7dbadbda940a7555ccf9227
#   Mainnet: 0x52f0e24d1c21c8a0cb1e5a5dd6198556bd9e1203
# ZAP_TOKENS: each token's route to ETH, as JSON. path[0] must be the token
# itself; each hop names the currency entering it. hooks/hookData default to none.
#   [{"symbol":"USDC","address":"0x…","decimals":6,
#     "path":[{"intermediateCurrency":"0x…","fee":500,"tickSpacing":10}]}]
ZAP_JOIN=
V4_QUOTER=
ZAP_TOKENS=

# ---------------------------------------------------------------- fee keeper
# FeeRouter on the hub chain. With KEEPER_PK set (any funded key: harvesting
# needs no role), the server harvests fees on a timer so they reach stakers.
# Blank disables it; anyone else can still harvest.
FEE_ROUTER=
# FEE_KEEPER_POLL_MS=60000
# HARVEST_MIN_WEI=50000000000000000            # 0.05 ETH credited before harvesting

# ------------------------------------------------------------------- staking
# StakedLms on the hub chain. Set, the lobby shows a staking panel.
STAKED_LMS=
# LmsGovernor on the hub chain. Set, the server indexes its proposals (served at
# /proposals) and the client shows a Governance screen. Start the scan at the
# governor's deployment block; from 0 on mainnet it reads every block ever.
GOVERNOR_ADDRESS=
GOVERNOR_FROM_BLOCK=

# ------------------------------------------------------------ match analyst
# Post-match analysis written by Gemini. Needs a Gemini API key; blank leaves
# the server running with analysis shown as unavailable, and nothing is sent
# anywhere. Never commit a real key.
GEMINI_API_KEY=
# `false` forces the analyst off even with a key.
# ANALYST_ENABLED=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# A Gemini 3 model or later.
# ANALYST_MODEL=gemini-3.8-flash
# low | medium | high | xhigh | max, as Gemini's thinking level (the top three mean high)
# ANALYST_EFFORT=medium
# Output ceiling per model turn, thinking included.
# ANALYST_MAX_TOKENS=16000
# Per attempt; timeouts and 5xx are retried this many times (a 429 never is).
# ANALYST_TIMEOUT_MS=120000
# ANALYST_MAX_RETRIES=2
# Ceiling on one whole analysis, every turn and retry included.
# ANALYST_DEADLINE_MS=180000
# Fresh analyses per wallet per hour; answers served from the cache are free.
# ANALYST_QUOTA_PER_HOUR=3
# Analyses being written at once, server-wide.
# ANALYST_MAX_CONCURRENT=1
# The Gemini project's rate limits, enforced by the server: requests per minute
# and per day (the day resets at midnight Pacific). Defaults are the free tier
# for Gemini 3.8 Flash; raise them once billing is on. `none` lifts either.
# ANALYST_RPM=5
# ANALYST_RPD=20
# Estimated spend per UTC day (USD, list prices) before fresh analyses stop
# until midnight. In memory: a restart resets it. `none` lifts the ceiling.
# ANALYST_DAILY_BUDGET_USD=10

# --------------------------------------------------------------- persistence
# Blank uses an in-memory archive: matches are lost on restart.
DATABASE_URL=

# ------------------------------------------------------------------- contracts
# Used by `forge script script/Deploy.s.sol`.
DEPLOYER_PK=
ETHERSCAN_API_KEY=

# Governance multisig (a Safe). It can veto (cancel) anything queued in the
# timelock, and is the emergency guardian, the default treasury, the avatar
# owner and the recipient of the LMS supply. Proposals come from the token
# governor, not the Safe. The deployer keeps no role and no tokens. Required on
# every chain but a local node (31337).
SAFE=
# Seconds a queued change waits. Must exceed joinWindow + settleWindow.
TIMELOCK_DELAY=86400
# Optional. Defaults to SAFE.
# TREASURY=

# Token governance and staking. All optional; defaults shown.
# LMS_SUPPLY=100000000000000000000000000        # 100M LMS, in wei
# STAKE_COOLDOWN=604800                         # 7 days; must exceed VOTING_PERIOD + TIMELOCK_DELAY
# VOTING_DELAY=86400
# VOTING_PERIOD=432000
# PROPOSAL_THRESHOLD=100000000000000000000000   # 100k sLMS, in wei
# QUORUM_PERCENT=4
# STAKER_FEE_BPS=5000                           # stakers' share of fees, paid to them in ETH

# Comma-separated attestor addresses, one per independently run server key.
# Defaults to the deployer alone. The threshold defaults to a majority: 1 of 1,
# 2 of 3, 3 of 5.
# ATTESTORS=0x…,0x…,0x…
# ATTESTOR_THRESHOLD=2

# Optional. Uniswap v4 PoolManager on the target chain; when set, the script
# also deploys ZapJoin so players can join paying in any token with a v4 route
# to ETH. Sepolia: 0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
# Mainnet: 0x000000000004444c5dc75cB358380D2e3dE08A90
# POOL_MANAGER=

# Avatar collection, deployed by the same script on every chain.
AVATAR_BASE_URI=ipfs://bafyplaceholder/
AVATAR_MAX_SUPPLY=10000

# ---------------------------------------------------------------- browser app
# Vite only exposes variables prefixed with VITE_.
VITE_WS_URL=ws://localhost:8787
VITE_RPC_URL=http://127.0.0.1:8545

# Development burner key. Lets you click through the practice loop without a
# wallet extension. Ignored in production builds. Never put a funded key here.
VITE_DEV_KEY=
